<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.matter.ignition</groupId>
        <artifactId>matter-ignition-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>matter-tag-provider-build</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.matter.ignition</groupId>
            <artifactId>matter-tag-provider-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.inductiveautomation.ignitionsdk</groupId>
                <artifactId>ignition-maven-plugin</artifactId>
                <version>1.1.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>modl</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <projectScopes>
                        <projectScope>
                            <name>matter-tag-provider-gateway</name>
                            <scope>G</scope>
                        </projectScope>
                    </projectScopes>

                    <moduleId>com.kyvislabs.matter.ignition.matter-tag-provider</moduleId>
                    <moduleName>Matter Tag Provider</moduleName>
                    <moduleDescription>Exposes Matter smart home device data as Ignition tags via a managed tag provider.</moduleDescription>
                    <moduleVersion>${module-base-version}.${maven.build.timestamp}</moduleVersion>
                    <requiredIgnitionVersion>${ignition-platform-version}</requiredIgnitionVersion>
                    <requiredFrameworkVersion>8</requiredFrameworkVersion>
                    <freeModule>true</freeModule>
                    <licenseFile>license.html</licenseFile>
                    <documentationFile>doc/index.html</documentationFile>

                    <hooks>
                        <hook>
                            <scope>G</scope>
                            <hookClass>com.matter.ignition.gateway.MatterTagProviderGatewayHook</hookClass>
                        </hook>
                    </hooks>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Signs the .modl with the Kyvis Labs key. Active when -Dsigning.dir=<dir> is given;
             that dir holds module-signing.pfx and module-signing.crt, and the key password
             comes from the SIGNING_PASSWORD environment variable. See scripts/build.sh. -->
        <profile>
            <id>sign</id>
            <activation>
                <property>
                    <name>signing.dir</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>fetch-module-signer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/signer</outputDirectory>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.inductiveautomation.ignitionsdk</groupId>
                                            <artifactId>module-signer</artifactId>
                                            <version>0.0.1.ia</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>commons-cli</groupId>
                                            <artifactId>commons-cli</artifactId>
                                            <version>1.3.1</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>commons-io</groupId>
                                            <artifactId>commons-io</artifactId>
                                            <version>2.1</version>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>sign-modl</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.directory}/signer/*</argument>
                                        <argument>com.inductiveautomation.ignitionsdk.ModuleSigner$Main</argument>
                                        <argument>-keystore=${signing.dir}/module-signing.pfx</argument>
                                        <argument>-keystore-pwd=${env.SIGNING_PASSWORD}</argument>
                                        <argument>-alias=kyvis-module-signing</argument>
                                        <argument>-alias-pwd=${env.SIGNING_PASSWORD}</argument>
                                        <argument>-chain=${signing.dir}/module-signing.crt</argument>
                                        <argument>-module-in=${project.build.directory}/Matter-Tag-Provider-unsigned.modl</argument>
                                        <argument>-module-out=${project.build.directory}/Matter-Tag-Provider.modl</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
